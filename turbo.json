{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#build": {
      "outputs": ["dist/**"]
    },
    "//#lint": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
